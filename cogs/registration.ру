# registration.py (cogs/registration.py)
import sqlite3
import datetime
import discord
from discord.ext import commands

# 1. При инициализации базы данных ОБЯЗАТЕЛЬНО включайте поддержку ВНЕШНИХ КЛЮЧЕЙ (Foreign Keys).
# По умолчанию в SQLite они ВЫКЛЮЧЕНЫ, из-за чего каскадное удаление (ON DELETE CASCADE) не срабатывает.
conn = sqlite3.connect('database.db')
conn.execute("PRAGMA foreign_keys = ON;")

class RegistrationCog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    # 2. Не сохраняйте временные токены/сессии в оперативной памяти (dict/set)!
    # Если бот перезапустится, память очистится, и пользователь потеряет прогресс регистрации.
    # Храните все временные данные прямо в БД или используйте файл конфигурации/Persistent Storage.

    @commands.Cog.listener()
    async def on_member_remove(self, member):
        """
        Главный источник проблемы: если пользователь вышел с сервера, 
        нужно явно обработать его удаление из базы данных.
        """
        db = sqlite3.connect('database.db')
        cursor = db.cursor()
        cursor.execute("PRAGMA foreign_keys = ON;")
        
        # Если каскадное удаление настроено в самой таблице, достаточно одной строчки:
        cursor.execute("DELETE FROM users WHERE user_id = ?", (member.id,))
        
        # Если каскада нет в схеме БД — удаляем вручную из связанных таблиц:
        # cursor.execute("DELETE FROM players WHERE user_id = ?", (member.id,))
        # cursor.execute("DELETE FROM registrations WHERE user_id = ?", (member.id,))
        
        db.commit()
        db.close()

